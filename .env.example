# Ollama endpoint. Local by default; nothing leaves the machine.
TAB_OLLAMA_HOST=http://127.0.0.1:11434
TAB_VISION_MODEL=

# Where the ledger lives.
TAB_DB_PATH=data/tab.db

# Folders watched in unattended mode.
TAB_INBOX_DIR=inbox
TAB_QUARANTINE_DIR=quarantine

# Peso tolerance for the arithmetic checks. Real receipts round; this knob
# needs turning against real paper, not guessed at. See docs/TDD.md.
TAB_AMOUNT_TOLERANCE=0.05
